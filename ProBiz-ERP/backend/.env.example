# Copy this file to .env and fill in your values

# Database — use SQLite for local, PostgreSQL for production
DATABASE_URL=sqlite:///./probiz_erp.db
# DATABASE_URL=postgresql://probiz_user:yourpassword@localhost:5432/probiz_db

# Security — MUST change this to a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=probiz-erp-super-secret-key-change-this-in-production

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated allowed origins (no trailing slashes)
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost
# Production (add your actual Vercel/Railway frontend URL):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.up.railway.app,http://localhost:3000

# App info
APP_NAME=ProBiz ERP
APP_VERSION=2.0.0

# Set to false in production (hides /docs and /redoc endpoints)
DEBUG=false
