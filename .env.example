# Copy to .env (never commit .env) and fill in real values.

# Database
POSTGRES_DB=probiz_db
POSTGRES_USER=probiz_user
POSTGRES_PASSWORD=change-me

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# First admin account created by seed.py.
# Leave the passwords empty to have seed.py generate random ones and print them once.
SEED_ADMIN_EMAIL=admin@probiz.pk
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# CORS and frontend
ALLOWED_ORIGINS=http://localhost,http://localhost:80
REACT_APP_API_URL=http://localhost:8000

# true shows /docs and /redoc
DEBUG=false
