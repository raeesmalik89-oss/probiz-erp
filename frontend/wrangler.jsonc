{
  // Cloudflare Workers Static Assets config for the ProBiz ERP frontend.
  // Build the Vite app (npm run build -> dist), then `npx wrangler deploy`
  // serves dist as static assets with SPA routing (no server/Worker script).
  "name": "probiz-erp",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
